# Copy to .env for local development (npm run dev). Never commit .env.
# On Vercel, set it in: Settings → Environment Variables.
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# (Users can also enter their own key in the app: 🔑 button in the navbar.)
GEMINI_API_KEY=your-api-key-here

# Optional: the Gemini model for all AI features (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
