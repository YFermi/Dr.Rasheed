# Copy to .env for local development (npm run dev). Never commit .env.
# On Vercel, set it in: Settings → Environment Variables.
# Create a key in the Anthropic Console: https://platform.claude.com/settings/keys
# (Users can also enter their own key in the app: 🔑 button in the navbar.)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: the Claude model for all AI features (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
